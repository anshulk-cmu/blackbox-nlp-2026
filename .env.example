# =============================================================================
# Environment variables for BlackBox-NLP project
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
# `.env` is gitignored and will NEVER be committed to the repository.
#
#   cp .env.example .env
#   # then edit .env and set the values below
#
# Loading this file:
#   - In Python: use `python-dotenv` (`from dotenv import load_dotenv; load_dotenv()`)
#   - In bash:   `set -a && source .env && set +a`
# =============================================================================

# -----------------------------------------------------------------------------
# HuggingFace
# -----------------------------------------------------------------------------
# Read-scope token for pulling model weights (GPT-J, Pythia, Llama 3.1).
# Get yours from: https://huggingface.co/settings/tokens
# Llama 3.1 also requires accepting the community license at:
#   https://huggingface.co/meta-llama/Meta-Llama-3.1-8B
HF_TOKEN=

# Optional: override HuggingFace cache location. Default is ~/.cache/huggingface.
# On Babel, prefer the data drive to keep $HOME small:
#   HF_HOME=/data/user_data/$USER/blackbox/hf_cache
HF_HOME=

# -----------------------------------------------------------------------------
# Project storage
# -----------------------------------------------------------------------------
# Where activations, manifolds, statistics, figures live.
# Default on Babel: /data/user_data/$USER/blackbox
BLACKBOX_DATA=

# -----------------------------------------------------------------------------
# Optional: Weights & Biases (if you decide to log runs)
# -----------------------------------------------------------------------------
# WANDB_API_KEY=
# WANDB_PROJECT=blackbox-nlp-2026
# WANDB_ENTITY=

# -----------------------------------------------------------------------------
# Optional: Anthropic / OpenAI (if any helper scripts call LLM APIs)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
